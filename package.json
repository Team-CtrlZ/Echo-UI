{
  "name": "design-system",
  "private": true,
  "version": "0.2.0-2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
